# Copy to `.env.local` for local development.
# Never commit real secrets. `.env*` is gitignored except this file.

# --- Required now (safe defaults exist for local/CI) ---
NODE_ENV=development
APP_ENV=local

# --- Database / Prisma (TASK-002) ---
# DATABASE_URL=
# DIRECT_URL=

# --- Supabase Auth identity (TASK-003). Application authorization stays in-app. ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 / S3-compatible storage (later StorageService) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# --- Redis / BullMQ (later worker) ---
# REDIS_URL=

# --- Resend / EmailService (later) ---
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Sentry (later monitoring task) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Payment provider secrets (adapters only; never used in domain logic) ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# BANK_PROCESSOR_API_KEY=
# BANK_PROCESSOR_WEBHOOK_SECRET=
