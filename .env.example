# Copy to `.env` (Prisma CLI) and `.env.local` (Next.js).
# Never commit real secrets. `.env*` is gitignored except this file.
#
# DATABASE_URL and DIRECT_URL are server-only. Never prefix them with NEXT_PUBLIC_.

# --- Required now (safe defaults exist for local/CI) ---
NODE_ENV=development
APP_ENV=local
# Public application origin used for password-recovery redirects. Required outside local.
# APP_URL=http://localhost:3000

# --- Database / Prisma (TASK-002) ---
# Runtime (pooled / Supavisor transaction pooler, typically port 6543):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Prisma CLI migrations / studio (direct, typically port 5432):
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"
#
# Local without a pooler: set both to the same direct PostgreSQL URL.
# DATABASE_URL=
# DIRECT_URL=

# --- Supabase Auth identity (TASK-003). Application authorization stays in-app. ---
# Browser-safe only. Never put SUPABASE_SERVICE_ROLE_KEY behind NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for Admin user provisioning (TASK-006). Server-only.
# SUPABASE_SERVICE_ROLE_KEY=
#
# Optional live auth tests (not required to boot):
# RUN_AUTH_INTEGRATION=true
# AUTH_TEST_EMAIL=
# AUTH_TEST_PASSWORD=
# Optional live recovery-link tests (service role, never NEXT_PUBLIC_):
# RUN_RECOVERY_INTEGRATION=true

# --- Operational bootstrap (TASK-006). Application DB only; not a runtime backdoor. ---
# pnpm bootstrap:admin -- --email existing-user@example.com

# --- Cloudflare R2 / S3-compatible storage (StorageService; logos TASK-010, PDFs later) ---
# Required outside local/test. Local/test may use .data/object-storage when unset.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# --- Redis / BullMQ (later worker) ---
# REDIS_URL=

# --- Resend / EmailService (later) ---
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Sentry (later monitoring task) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Payment provider secrets (adapters only; never used in domain logic) ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# BANK_PROCESSOR_API_KEY=
# BANK_PROCESSOR_WEBHOOK_SECRET=
