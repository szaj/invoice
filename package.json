{
  "name": "invoices",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-brand invoice management platform",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.mts",
    "e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "build": "prisma generate && next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.542.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0",
    "resend": "^6.21.0",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
