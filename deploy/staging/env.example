# Staging / UAT environment template (TASK-102)
# Copy to `env` in this directory: cp env.example env
# Never commit the filled `env` file. Use a dedicated Supabase project and R2 bucket.

# --- Application ---
APP_ENV=staging
NODE_ENV=production
APP_URL=https://uat.example.com

# --- Database (dedicated Supabase UAT project — not production) ---
DATABASE_URL=postgresql://postgres:password@db.uat-project.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:password@db.uat-project.supabase.co:5432/postgres?sslmode=require

# --- Supabase Auth (UAT project) ---
NEXT_PUBLIC_SUPABASE_URL=https://uat-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-uat-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-uat-service-role-key

# --- Redis (provided by compose — override only for external Redis) ---
# REDIS_URL=redis://redis:6379

# --- Object storage (dedicated UAT R2 bucket with versioning enabled) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=invoices-uat
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Email (Resend sandbox or dedicated UAT sender) ---
RESEND_API_KEY=
EMAIL_FROM=UAT Invoices <uat@example.com>

# --- Monitoring (optional UAT Sentry project) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Gateway credential encryption (generate unique UAT keys — never reuse production) ---
GATEWAY_CREDENTIALS_KEY_VERSION=1
GATEWAY_CREDENTIALS_KEY_V1=base64-encoded-32-byte-key

# --- Payment provider sandbox credentials (never live/production keys in UAT) ---
# Per-company gateway config in the app uses these only when configured at company level.
# Global env vars below are optional fallbacks for adapter smoke tests.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
PAYPAL_CLIENT_ID=sandbox-client-id
PAYPAL_CLIENT_SECRET=sandbox-client-secret
PAYPAL_WEBHOOK_ID=sandbox-webhook-id

# --- Backups (optional on UAT VPS) ---
BACKUP_DIR=/var/backups/invoices-uat
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26

# --- Compose / Caddy (host-side — not passed into app containers unless referenced) ---
UAT_DOMAIN=uat.example.com
UAT_ACME_EMAIL=ops@example.com
UAT_HTTP_PORT=8080
UAT_HTTPS_PORT=8443
RUN_MIGRATIONS_ON_START=true
