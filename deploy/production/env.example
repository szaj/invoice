# Production environment template (TASK-103)
# Copy to `env` in this directory: cp env.example env
# Never commit the filled `env` file. Use the production Supabase project and R2 bucket only.

# --- Application ---
APP_ENV=production
NODE_ENV=production
APP_URL=https://app.example.com

# --- Database (production Supabase project — managed off-VPS) ---
DATABASE_URL=postgresql://postgres:password@db.prod-project.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:password@db.prod-project.supabase.co:5432/postgres?sslmode=require

# --- Supabase Auth (production project) ---
NEXT_PUBLIC_SUPABASE_URL=https://prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# --- Redis (provided by compose — override only for external Redis) ---
# REDIS_URL=redis://redis:6379

# --- Object storage (production R2 bucket with object versioning enabled) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=invoices-production
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Email (Resend production sender) ---
RESEND_API_KEY=
EMAIL_FROM=Invoices <billing@example.com>

# --- Monitoring (recommended — separate Sentry project for production) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Gateway credential encryption (generate unique production keys — never reuse UAT) ---
GATEWAY_CREDENTIALS_KEY_VERSION=1
GATEWAY_CREDENTIALS_KEY_V1=base64-encoded-32-byte-key

# --- Payment provider credentials ---
# Live Stripe / PayPal credentials are configured per company in the Admin UI.
# Optional env fallbacks for adapter smoke tests only — never commit live secrets to git.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=live-client-id
# PAYPAL_CLIENT_SECRET=live-client-secret
# PAYPAL_WEBHOOK_ID=live-webhook-id

# --- Backups (required on production VPS — Admin health at /settings/operations) ---
BACKUP_DIR=/var/backups/invoices
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26

# --- Compose / Caddy (host-side — referenced by caddy service) ---
PROD_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
RUN_MIGRATIONS_ON_START=true
