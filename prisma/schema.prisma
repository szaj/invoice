// TASK-003 adds identity mapping (`users`).
// TASK-004 adds password_reset_required (workflow flag, not a credential).
// TASK-005 adds roles / permissions in the application database.
// TASK-006 adds Admin user-management fields (employee_id, mfa_enabled, created_by).
// TASK-007 adds companies (identity, address, status, names).
// TASK-008 adds user_companies (user-to-company assignment).
// TASK-010 adds company branding fields and logo file metadata.
// TASK-035 adds companies.invoice_sequence_next and system_settings.invoice_number_include_year.
// TASK-011 adds company_groups and companies.reporting_group_id (reporting only).
// TASK-012 adds append-only audit_logs (application audit trail; not Pino).
// TASK-013 adds system_settings (reporting currency, timezone, rounding placeholder).
// TASK-014 adds currencies (global catalog; company enablement and rates are later).
// TASK-015 adds company_currencies (per-company enabled subset + default invoice currency).
// TASK-016 adds fixed_conversion_rates (Admin-defined; no live FX; versioning expire is TASK-017).
// TASK-017 expires prior ACTIVE versions on create (append-only; retained permanently).
// TASK-018 selects effective rate by valid_from/valid_to at a timestamp (no payment conversion).
// TASK-020 adds payment_gateway_configs settlement-currency enablement (no credentials/charges).
// TASK-049 extends payment_gateway_configs with ADR-022 encrypted credentials, environment, provider config.
// TASK-021 formalizes currency disable vs historical visibility (status flags only).
// TASK-022 adds customers master (fields from Customers §7.1).
// TASK-025 adds customer_companies (multi-company linkage; access via linked companies).
// TASK-027 adds customer_notes (internal-only; author/timestamp).
// TASK-030 adds invoices header (company+customer; draft status; no line items/payments).
// TASK-033 adds invoice_items (line totals server-side; discount blocked until ADR-010).
// TASK-034 adds stored invoice totals (recalculated from items/payments; discount total = 0 while ADR-010 OPEN).
// TASK-037 adds invoice_versions (immutable snapshots on issue; ADR-009 financial revision OPEN).
// TASK-038 adds invoices.cancellation_reason / cancelled_at / cancelled_by (soft cancel; BR-012).
// TASK-039 adds invoice_files (PDF metadata; blob in StorageService / R2 — ADR-006 / ADR-013).
// TASK-041 adds email_logs (invoice email delivery; EmailService → ResendAdapter — ADR-007).
// TASK-044 adds payments (provider-agnostic payment records; no charges/webhooks/allocation).
// TASK-063 adds payment_adjustments (dispute open/under review; original SUCCESSFUL payment immutable).
// TASK-071 adds compliance_status on customers/payments (invoices already had it) and compliance_reviews.
// TASK-073 adds compliance_reviews notes / reason / resolution_notes / evidence_refs.
// Do not add payment charging, customer portal, or live FX here.
//
// Conventions for later models (PostgreSQL / Prisma):
// - id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
// - company_id      String   @db.Uuid   // required on transactional tables
// - created_at      DateTime @default(now()) @db.Timestamptz
// - updated_at      DateTime @updatedAt @db.Timestamptz
// - money           Decimal  @db.Decimal(19, 4)
// - conversion_rate Decimal  @db.Decimal(20, 12)
// Never use Float, Double, or JavaScript number for authoritative money.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum RoleCode {
  ADMIN
  COMPLIANCE
  STAFF

  @@map("role_code")
}

enum RoleCompanyScope {
  ALL
  ASSIGNED

  @@map("role_company_scope")
}

/// Application RBAC role. Authorization lives here, not in Supabase Auth metadata.
model Role {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         RoleCode         @unique
  name         String
  companyScope RoleCompanyScope @map("company_scope")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  permissions  RolePermission[]
  users        User[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String           @unique
  name      String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Application identity record linked to Supabase Auth.
/// role_id is application authorization, not an Auth credential.
/// password_reset_required is an application workflow flag, not a credential or permission.
/// Company assignment lives on user_companies, not on this row and not in Auth metadata.
model User {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  email                 String        @unique
  supabaseAuthUserId    String        @unique @map("supabase_auth_user_id") @db.Uuid
  status                UserStatus    @default(ACTIVE)
  roleId                String?       @map("role_id") @db.Uuid
  employeeId            String?       @map("employee_id")
  mfaEnabled            Boolean       @default(false) @map("mfa_enabled")
  lastLoginAt           DateTime?     @map("last_login_at") @db.Timestamptz
  passwordResetRequired Boolean       @default(false) @map("password_reset_required")
  createdByUserId       String?       @map("created_by_user_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  role                  Role?         @relation(fields: [roleId], references: [id])
  createdBy             User?         @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers          User[]        @relation("UserCreatedBy")
  companies             UserCompany[]
  assignedCustomers     Customer[]     @relation("CustomerAssignedStaff")
  createdCustomers      Customer[]     @relation("CustomerCreatedBy")
  updatedCustomers      Customer[]     @relation("CustomerUpdatedBy")
  authoredCustomerNotes CustomerNote[] @relation("CustomerNoteAuthor")
  assignedInvoices      Invoice[]      @relation("InvoiceAssignedStaff")
  createdInvoices       Invoice[]      @relation("InvoiceCreatedBy")
  updatedInvoices       Invoice[]      @relation("InvoiceUpdatedBy")
  createdInvoiceVersions InvoiceVersion[] @relation("InvoiceVersionCreatedBy")
  cancelledInvoices      Invoice[] @relation("InvoiceCancelledBy")
  createdInvoiceFiles    InvoiceFile[] @relation("InvoiceFileCreatedBy")
  sentEmailLogs          EmailLog[] @relation("EmailLogSentBy")
  createdPayments        Payment[] @relation("PaymentCreatedBy")
  confirmedPayments      Payment[] @relation("PaymentConfirmedBy")
  createdPaymentAdjustments PaymentAdjustment[] @relation("PaymentAdjustmentCreatedBy")
  complianceReviews      ComplianceReview[] @relation("ComplianceReviewReviewer")
  requestedReportExports ReportExport[] @relation("ReportExportRequestedBy")

  @@map("users")
}

enum AuditActorType {
  USER
  SYSTEM
  WEBHOOK

  @@map("audit_actor_type")
}

/// Append-only application audit trail (BR-015). Not operational Pino logs.
/// Application layer must not expose update/delete APIs for this table.
/// actor_user_id / company_id are historical references without FKs so rows survive
/// actor/company lifecycle and remain writable for system/login events.
model AuditLog {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  companyId     String?        @map("company_id") @db.Uuid
  entityType    String         @map("entity_type")
  entityId      String?        @map("entity_id")
  action        String
  oldValues     Json?          @map("old_values")
  newValues     Json?          @map("new_values")
  reason        String?
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  correlationId String?        @map("correlation_id")

  @@index([occurredAt])
  @@index([actorUserId])
  @@index([companyId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE

  @@map("company_status")
}

enum ReportingGroupStatus {
  ACTIVE
  INACTIVE

  @@map("reporting_group_status")
}

/// Optional parent reporting group for consolidated reporting roll-ups.
/// Membership is organizational/reporting only and never grants company access.
model CompanyGroup {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  code         String               @unique
  status       ReportingGroupStatus @default(ACTIVE)
  displayOrder Int                  @default(0) @map("display_order")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  companies    Company[]

  @@map("company_groups")
}

/// Company/brand identity, structured address, branding, and active/inactive status.
/// Gateway credentials and currencies are later tasks; invoice sequence allocation is TASK-035.
/// reporting_group_id is for report roll-ups only; authorization uses user_companies.
/// Logo bytes live in object storage; only metadata is stored here.
model Company {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName            String        @map("display_name")
  legalName              String?       @map("legal_name")
  email                  String?
  phone                  String?
  website                String?
  registrationTaxNumber  String?       @map("registration_tax_number")
  addressLine1           String?       @map("address_line1")
  addressLine2           String?       @map("address_line2")
  city                   String?
  region                 String?
  postalCode             String?       @map("postal_code")
  countryCode            String?       @map("country_code") @db.Char(2)
  invoicePrefix          String?       @map("invoice_prefix")
  /// Next sequence value to allocate for this company (TASK-035). Never decreases.
  invoiceSequenceNext    Int           @default(1) @map("invoice_sequence_next")
  termsAndConditions     String?       @map("terms_and_conditions")
  emailTemplateReference String?       @map("email_template_reference")
  logoStorageKey         String?       @map("logo_storage_key")
  logoMimeType           String?       @map("logo_mime_type")
  logoByteSize           Int?          @map("logo_byte_size")
  logoOriginalFilename   String?       @map("logo_original_filename")
  logoUploadedAt         DateTime?     @map("logo_uploaded_at") @db.Timestamptz
  reportingGroupId       String?       @map("reporting_group_id") @db.Uuid
  status                 CompanyStatus @default(ACTIVE)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  reportingGroup         CompanyGroup? @relation(fields: [reportingGroupId], references: [id], onDelete: SetNull)
  users                  UserCompany[]
  currencies             CompanyCurrency[]
  paymentGatewayConfigs  PaymentGatewayConfig[]
  defaultForCustomers    Customer[]
  customerLinks          CustomerCompany[]
  invoices               Invoice[]
  emailLogs              EmailLog[]
  payments               Payment[]
  paymentEvents          PaymentEvent[]
  paymentAdjustments     PaymentAdjustment[]
  complianceReviews      ComplianceReview[]
  reportExports          ReportExport[]

  @@index([reportingGroupId])
  @@map("companies")
}

/// Controls company access for Compliance and Staff.
/// Admin authorization is all companies regardless of rows here.
/// Reporting-group membership is not authorization.
model UserCompany {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

/// Singleton-style core system settings for later phases.
/// reporting_currency_code is configurable (ADR-011 remains OPEN; seed is a recommendation).
/// Secrets must never be stored here unencrypted. Gateway credentials and fixed rates are later tasks.
model SystemSettings {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportingCurrencyCode String   @map("reporting_currency_code")
  defaultTimezone       String   @map("default_timezone")
  /// Placeholder for later money utilities (TASK-019). Authoritative money still uses Decimal.
  roundingTolerance     Decimal  @default(0) @map("rounding_tolerance") @db.Decimal(19, 4)
  /// When true, allocated invoice numbers include YYYY between prefix and sequence (TASK-035).
  invoiceNumberIncludeYear Boolean @default(false) @map("invoice_number_include_year")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

enum CurrencyStatus {
  ACTIVE
  INACTIVE

  @@map("currency_status")
}

/// Global currency catalog. Company enablement is TASK-015; fixed rates are TASK-016+.
/// Soft-disable via status only (no hard-delete). Disabled rows remain for historical
/// display (BR-011) and are rejected by new-document selection hooks (TASK-021).
model Currency {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String           @unique @db.Char(3)
  name             String
  symbol           String
  decimalPrecision Int              @map("decimal_precision")
  status           CurrencyStatus   @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  companies        CompanyCurrency[]

  @@index([status])
  @@map("currencies")
}

/// Per-company enabled invoice currencies and default invoice currency.
/// Presence with enabled=true and globally ACTIVE means selectable for new documents (BR-002).
/// Globally INACTIVE assignments may remain for historical visibility; new selection rejects them (TASK-021).
/// Settlement currencies are on payment_gateway_settlement_currencies (TASK-020).
model CompanyCurrency {
  companyId  String   @map("company_id") @db.Uuid
  currencyId String   @map("currency_id") @db.Uuid
  enabled    Boolean  @default(true)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@id([companyId, currencyId])
  @@index([currencyId])
  @@index([companyId, isDefault])
  @@map("company_currencies")
}

enum FixedConversionRateStatus {
  ACTIVE
  EXPIRED

  @@map("fixed_conversion_rate_status")
}

enum FixedConversionRateFrequency {
  MONTHLY
  YEARLY
  MANUAL

  @@map("fixed_conversion_rate_frequency")
}

/// Admin-defined fixed conversion rates only (no live FX / gateway rates).
/// Append-only versions: create new rows; never PATCH fixed_rate on historical rows.
/// Effective selection for payments uses valid_from/valid_to windows (TASK-018).
/// Creating a new version expires/closes prior ACTIVE versions for the same pair (retained).
model FixedConversionRate {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCurrency     String                         @map("from_currency") @db.Char(3)
  toCurrency       String                         @map("to_currency") @db.Char(3)
  fixedRate        Decimal                        @map("fixed_rate") @db.Decimal(20, 12)
  versionNo        Int                            @map("version_no")
  frequencyLabel   FixedConversionRateFrequency   @map("frequency_label")
  validFrom        DateTime                       @map("valid_from") @db.Timestamptz
  validTo          DateTime?                      @map("valid_to") @db.Timestamptz
  status           FixedConversionRateStatus      @default(ACTIVE)
  notes            String?
  createdByUserId  String?                        @map("created_by") @db.Uuid
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  paymentSnapshots Payment[]

  @@unique([fromCurrency, toCurrency, versionNo])
  @@index([fromCurrency, toCurrency, status])
  @@index([validFrom])
  @@map("fixed_conversion_rates")
}

/// Version 1 payment methods (provider-agnostic codes; adapters later).
enum PaymentMethodCode {
  STRIPE
  PAYPAL
  BANK_PROCESSOR
  MANUAL

  @@map("payment_method_code")
}

/// Sandbox vs live operating mode for a company gateway method (TASK-049).
enum GatewayEnvironment {
  SANDBOX
  LIVE

  @@map("gateway_environment")
}

/// Company payment-method / gateway config shape.
/// Settlement currency enablement is TASK-020 (BR-006 / BR-007).
/// TASK-048 resolves PaymentProvider adapters by methodCode against this shape.
/// TASK-049 stores ADR-022 envelope-encrypted credentials + sandbox/live + non-secret provider config.
/// Never store plaintext credentials. Never put credentials on `payments`.
model PaymentGatewayConfig {
  id                        String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                 String                             @map("company_id") @db.Uuid
  methodCode                PaymentMethodCode                  @map("method_code")
  /// Whether this payment method is enabled for the company (modes on/off).
  enabled                   Boolean                            @default(false)
  /// Sandbox/Test vs Live. Null until Admin sets an environment.
  environment               GatewayEnvironment?                @map("environment")
  /// Non-secret provider-specific configuration (opaque JSON). Never credentials.
  providerConfig            Json?                              @map("provider_config")
  /// ADR-022 envelope: encrypted credential JSON (includes webhook secret when present).
  credentialsCiphertext     Bytes?                             @map("credentials_ciphertext")
  credentialsNonce          Bytes?                             @map("credentials_nonce")
  credentialsAuthTag        Bytes?                             @map("credentials_auth_tag")
  wrappedDek                Bytes?                             @map("wrapped_dek")
  dekWrapNonce              Bytes?                             @map("dek_wrap_nonce")
  dekWrapAuthTag            Bytes?                             @map("dek_wrap_auth_tag")
  /// KEK version used to wrap the DEK (for rotation).
  kekKeyVersion             Int?                               @map("kek_key_version")
  /// Envelope format version for future crypto migrations.
  encryptionFormatVersion   Int?                               @map("encryption_format_version")
  createdAt                 DateTime                           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime                           @updatedAt @map("updated_at") @db.Timestamptz
  company                   Company                            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  settlementCurrencies      PaymentGatewaySettlementCurrency[]

  @@unique([companyId, methodCode])
  @@index([companyId])
  @@map("payment_gateway_configs")
}

/// Per payment-method settlement currencies enabled for a company.
/// Initial Version 1 currencies are USD and AED; Admin may enable other ACTIVE catalog codes.
model PaymentGatewaySettlementCurrency {
  gatewayConfigId String              @map("gateway_config_id") @db.Uuid
  currencyCode    String              @map("currency_code") @db.Char(3)
  enabled         Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  gatewayConfig   PaymentGatewayConfig @relation(fields: [gatewayConfigId], references: [id], onDelete: Cascade)

  @@id([gatewayConfigId, currencyCode])
  @@index([currencyCode])
  @@map("payment_gateway_settlement_currencies")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

/// Customer master record (Customers §7.1).
/// Email is optional at create (required later only to email an invoice — BR-017).
/// Multi-company linkage via customer_companies (TASK-025). Soft status only (BR-012); no hard-delete API.
/// default_company_id is a preference, not ownership or authorization.
model Customer {
  id                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName                String            @map("display_name")
  contactPerson              String?           @map("contact_person")
  customerType               CustomerType      @map("customer_type")
  email                      String?
  phone                      String?
  alternatePhone             String?           @map("alternate_phone")
  addressLine1               String?           @map("address_line1")
  addressLine2               String?           @map("address_line2")
  city                       String?
  region                     String?
  postalCode                 String?           @map("postal_code")
  countryCode                String?           @map("country_code") @db.Char(2)
  taxRegistrationId          String?           @map("tax_registration_id")
  website                    String?
  defaultInvoiceCurrencyCode String?           @map("default_invoice_currency_code") @db.Char(3)
  defaultCompanyId           String?           @map("default_company_id") @db.Uuid
  paymentPreference          String?           @map("payment_preference")
  status                     CustomerStatus    @default(ACTIVE)
  /// Compliance review status (TASK-071). Default Not Reviewed; Staff cannot change.
  complianceStatus           ComplianceStatus  @default(NOT_REVIEWED) @map("compliance_status")
  assignedStaffUserId        String?           @map("assigned_staff_user_id") @db.Uuid
  internalNotes              String?           @map("internal_notes")
  tags                       String[]          @default([])
  createdByUserId            String?           @map("created_by_user_id") @db.Uuid
  updatedByUserId            String?           @map("updated_by_user_id") @db.Uuid
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  defaultCompany             Company?          @relation(fields: [defaultCompanyId], references: [id], onDelete: SetNull)
  assignedStaff              User?             @relation("CustomerAssignedStaff", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  createdBy                  User?             @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                  User?             @relation("CustomerUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  companyLinks               CustomerCompany[]
  notes                      CustomerNote[]
  invoices                   Invoice[]
  payments                   Payment[]

  @@index([status])
  @@index([complianceStatus])
  @@index([displayName])
  @@index([email])
  @@index([defaultCompanyId])
  @@index([assignedStaffUserId])
  @@map("customers")
}

/// Links a customer master to one or more companies without duplicating the customer.
/// Authorization for Staff/Compliance is intersection with user_companies (TASK-025).
model CustomerCompany {
  customerId String   @map("customer_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([customerId, companyId])
  @@index([companyId])
  @@map("customer_companies")
}

enum CustomerNoteVisibility {
  INTERNAL

  @@map("customer_note_visibility")
}

/// Internal-only customer notes thread (Customers §7.2 / TASK-027).
/// Never customer-portal visible. Never included on PDF/email payloads.
model CustomerNote {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String                 @map("customer_id") @db.Uuid
  authorUserId String                 @map("author_user_id") @db.Uuid
  body         String
  visibility   CustomerNoteVisibility @default(INTERNAL)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  customer     Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author       User                   @relation("CustomerNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([authorUserId])
  @@map("customer_notes")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

/// Shared compliance review statuses (Compliance §11.1 / TASK-071).
enum ComplianceStatus {
  NOT_REVIEWED
  UNDER_REVIEW
  APPROVED
  FLAGGED

  @@map("compliance_status")
}

enum ComplianceReviewSubjectType {
  INVOICE
  PAYMENT
  CUSTOMER

  @@map("compliance_review_subject_type")
}

/// Compliance review history row (TASK-071 / TASK-073).
/// Notes, reason codes, resolution notes, and optional evidence refs on each review event.
/// Subject status is also denormalized on invoice/payment/customer for queues.
model ComplianceReview {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String                       @map("company_id") @db.Uuid
  subjectType      ComplianceReviewSubjectType  @map("subject_type")
  subjectId        String                       @map("subject_id") @db.Uuid
  status           ComplianceStatus
  /// Internal compliance notes for this review event.
  notes            String?
  /// Reason code (free text until a settings catalog exists).
  reason           String?
  /// Resolution notes when closing or clarifying a review.
  resolutionNotes  String?                      @map("resolution_notes")
  /// Optional evidence/attachment storage-key references when enabled (string JSON array).
  evidenceRefs     Json?                        @map("evidence_refs")
  reviewerUserId   String?                      @map("reviewer_user_id") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  company          Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reviewer         User?                        @relation("ComplianceReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([subjectType, subjectId])
  @@index([createdAt])
  @@map("compliance_reviews")
}

/// Invoice header (Invoices §8.2 / TASK-030). BR-001: exactly one company and one customer.
/// Numbering lock / issue / PDF / payments / totals are later tasks.
/// invoice_number is nullable until TASK-035; unique per company when set.
/// Transactional writes require a concrete company context (TASK-009), not All Companies.
model Invoice {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  customerId       String                  @map("customer_id") @db.Uuid
  /// System-generated per company; null while draft before numbering (TASK-035).
  invoiceNumber    String?                 @map("invoice_number")
  invoiceDate      DateTime                @map("invoice_date") @db.Date
  dueDate          DateTime                @map("due_date") @db.Date
  /// Invoice currency code; must be enabled for company when drafting (BR-002 / TASK-031).
  currencyCode     String                  @map("currency_code") @db.Char(3)
  referencePo      String?                 @map("reference_po")
  assignedStaffUserId String?              @map("assigned_staff_user_id") @db.Uuid
  status           InvoiceStatus      @default(DRAFT)
  complianceStatus ComplianceStatus   @default(NOT_REVIEWED) @map("compliance_status")
  /// Never printed or emailed (Invoices §8.2).
  internalNotes    String?            @map("internal_notes")
  /// Optional invoice-visible notes (PDF/email later).
  customerNotes    String?            @map("customer_notes")
  /// Stored totals (TASK-034). Recalculated from line items / confirmed payment applications.
  subtotal             Decimal @default(0) @map("subtotal") @db.Decimal(19, 4)
  /// Always 0 while ADR-010 remains OPEN — not a manually editable discount.
  discountTotal        Decimal @default(0) @map("discount_total") @db.Decimal(19, 4)
  taxTotal             Decimal @default(0) @map("tax_total") @db.Decimal(19, 4)
  invoiceTotal         Decimal @default(0) @map("invoice_total") @db.Decimal(19, 4)
  /// Cached sum of confirmed applications (BR-009); never a manually edited paid total.
  confirmedPaidAmount  Decimal @default(0) @map("confirmed_paid_amount") @db.Decimal(19, 4)
  outstandingAmount    Decimal @default(0) @map("outstanding_amount") @db.Decimal(19, 4)
  /// Soft-cancel reason (TASK-038 / BR-012). Financial totals are not rewritten on cancel.
  cancellationReason   String?   @map("cancellation_reason")
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledByUserId    String?   @map("cancelled_by_user_id") @db.Uuid
  createdByUserId  String?            @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?            @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedStaff    User?              @relation("InvoiceAssignedStaff", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  createdBy        User?              @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy        User?              @relation("InvoiceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  cancelledBy      User?              @relation("InvoiceCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  lineItems        InvoiceItem[]
  versions         InvoiceVersion[]
  files            InvoiceFile[]
  emailLogs        EmailLog[]
  payments         Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, status, dueDate])
  @@index([companyId, status, invoiceDate])
  @@index([companyId, invoiceDate])
  @@index([companyId, currencyCode, invoiceDate])
  @@index([companyId, outstandingAmount, dueDate])
  @@index([companyId, complianceStatus])
  @@index([companyId, complianceStatus, invoiceDate])
  @@index([companyId, customerId, currencyCode])
  @@index([customerId])
  @@index([assignedStaffUserId])
  @@index([invoiceDate])
  @@map("invoices")
}

/// Immutable invoice document snapshot (TASK-037). Created on issue.
/// Does not authorize issued financial edits while ADR-009 is OPEN.
/// Historical rows are never updated or hard-deleted.
model InvoiceVersion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  versionNo       Int      @map("version_no")
  /// Header + line items + totals snapshot at creation time (Decimal strings).
  snapshot        Json
  reason          String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy       User?    @relation("InvoiceVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  files           InvoiceFile[]

  @@unique([invoiceId, versionNo])
  @@index([invoiceId])
  @@map("invoice_versions")
}

/// Stored invoice PDF metadata (TASK-039 / ADR-006). Binary lives in StorageService (R2).
/// One PDF per invoice version; never regenerate from today's mutable data when a row exists.
model InvoiceFile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  invoiceVersionId String   @map("invoice_version_id") @db.Uuid
  storageKey       String   @map("storage_key")
  checksumSha256   String   @map("checksum_sha256") @db.Char(64)
  byteSize         Int      @map("byte_size")
  contentType      String   @default("application/pdf") @map("content_type")
  /// A4 or LETTER (PDF and Email §9.1).
  pageSize         String   @default("A4") @map("page_size")
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceVersion   InvoiceVersion @relation(fields: [invoiceVersionId], references: [id], onDelete: Restrict)
  createdBy        User?    @relation("InvoiceFileCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  emailLogs        EmailLog[]

  @@unique([invoiceVersionId])
  @@index([invoiceId])
  @@map("invoice_files")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

/// Invoice (and later operational) email delivery log (TASK-041 / ADR-007).
/// Email failure must not un-issue an invoice. PDF binaries are not stored here.
model EmailLog {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  invoiceId         String              @map("invoice_id") @db.Uuid
  invoiceFileId     String?             @map("invoice_file_id") @db.Uuid
  recipient         String
  subject           String
  status            EmailDeliveryStatus
  providerMessageId String?             @map("provider_message_id")
  errorMessage      String?             @map("error_message")
  /// True when status is FAILED and a later retry is allowed.
  retryable         Boolean             @default(false)
  sentByUserId      String?             @map("sent_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice           Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceFile       InvoiceFile?        @relation(fields: [invoiceFileId], references: [id], onDelete: SetNull)
  sentBy            User?               @relation("EmailLogSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([companyId, createdAt])
  @@map("email_logs")
}

/// Invoice line item (Invoices §8.3 / TASK-033).
/// Discount omitted until ADR-010 is accepted. Tax name/rate are optional snapshots;
/// TASK-034 aggregates tax into invoice tax_total from these snapshots. line_total is pre-tax.
model InvoiceItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  description     String
  /// Decimal > 0; default 1.
  quantity        Decimal  @db.Decimal(20, 6)
  /// Unit rate in invoice currency (ADR-004).
  unitRate        Decimal  @map("unit_rate") @db.Decimal(19, 4)
  /// Optional tax name snapshot (Invoices §8.3).
  taxName         String?  @map("tax_name")
  /// Optional tax rate percentage snapshot used for invoice tax_total (TASK-034).
  taxRatePercent  Decimal? @map("tax_rate_percent") @db.Decimal(10, 6)
  /// Server-calculated: round(quantity × unit_rate) in invoice currency precision (pre-tax).
  lineTotal       Decimal  @map("line_total") @db.Decimal(19, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_items")
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED

  @@map("payment_status")
}

/// How the payment record entered the system (ADR-008). Not a provider brand.
enum PaymentSource {
  MANUAL
  GATEWAY_API
  GATEWAY_WEBHOOK
  SYSTEM

  @@map("payment_source")
}

/// Rate provenance for the locked snapshot (BR-020 / BR-021). Never market/gateway FX.
enum PaymentRateSource {
  ADMIN_FIXED_RATE
  SAME_CURRENCY

  @@map("payment_rate_source")
}

/// Provider-agnostic payment record (Payments §10.3 / TASK-044 / ADR-008).
/// Core application statuses: Pending / Successful / Failed.
/// Refunds/disputes/chargebacks are linked adjustments — never rewrite SUCCESSFUL financial fields (BR-004/005).
/// Merchant/processor fee and actual received are optional reconciliation only (BR-020); excluded from conversion and invoice balance.
/// No gateway credentials, Stripe-/PayPal-specific columns, charging, webhooks, or allocation here.
model Payment {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String            @map("company_id") @db.Uuid
  invoiceId                String            @map("invoice_id") @db.Uuid
  /// Snapshot/reference to the customer at payment time (Payments §10.3).
  customerId               String            @map("customer_id") @db.Uuid
  /// Provider-agnostic method code (STRIPE / PAYPAL / BANK_PROCESSOR / MANUAL). Adapters later.
  methodCode               PaymentMethodCode @map("method_code")
  /// External provider/manual reference. Provider-neutral; not a credential.
  externalTransactionId    String?           @map("external_transaction_id")
  status                   PaymentStatus     @default(PENDING)
  /// Compliance review status (TASK-071). Default Not Reviewed; Staff cannot change.
  complianceStatus         ComplianceStatus  @default(NOT_REVIEWED) @map("compliance_status")
  invoiceCurrencyCode      String            @map("invoice_currency_code") @db.Char(3)
  /// Amount applied to the invoice balance in invoice currency (ADR-004).
  invoiceAmountApplied     Decimal           @map("invoice_amount_applied") @db.Decimal(19, 4)
  settlementCurrencyCode   String            @map("settlement_currency_code") @db.Char(3)
  /// Locked Admin-defined fixed rate snapshot (or 1 for same-currency). Never recalculated (BR-020/021).
  fixedConversionRate      Decimal           @map("fixed_conversion_rate") @db.Decimal(20, 12)
  /// Link to the fixed_conversion_rates version snapshotted for this payment (null when same-currency).
  rateVersionId            String?           @map("rate_version_id") @db.Uuid
  rateSource               PaymentRateSource @map("rate_source")
  /// Effective timestamp of the Admin rate version used; payment date when same-currency (TASK-046).
  rateEffectiveAt          DateTime?         @map("rate_effective_at") @db.Timestamptz
  /// invoice_amount_applied × fixed_conversion_rate; fee excluded (TASK-019 / BR-020).
  convertedSettlementAmount Decimal          @map("converted_settlement_amount") @db.Decimal(19, 4)
  /// Optional processor/merchant fee in settlement currency — reconciliation only.
  processorFeeAmount       Decimal?          @map("processor_fee_amount") @db.Decimal(19, 4)
  /// Optional actual amount received — not auto-derived from fee (Definitions / TASK-047 behavior).
  actualReceivedAmount     Decimal?          @map("actual_received_amount") @db.Decimal(19, 4)
  paymentDate              DateTime          @map("payment_date") @db.Date
  receivedAt               DateTime?         @map("received_at") @db.Timestamptz
  source                   PaymentSource
  notes                    String?
  createdByUserId          String?           @map("created_by_user_id") @db.Uuid
  confirmedByUserId        String?           @map("confirmed_by_user_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice                  Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer                 Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  rateVersion              FixedConversionRate? @relation(fields: [rateVersionId], references: [id], onDelete: SetNull)
  createdBy                User?             @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmedBy              User?             @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  events                   PaymentEvent[]
  adjustments              PaymentAdjustment[]

  @@index([companyId, status])
  @@index([companyId, status, paymentDate])
  @@index([companyId, complianceStatus])
  @@index([companyId, complianceStatus, paymentDate])
  @@index([companyId, methodCode, complianceStatus])
  @@index([companyId, methodCode, paymentDate])
  @@index([companyId, settlementCurrencyCode, paymentDate])
  @@index([invoiceId])
  @@index([customerId])
  @@index([methodCode, externalTransactionId])
  @@index([paymentDate])
  @@map("payments")
}

enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@map("payment_event_processing_status")
}

/// Gateway webhook/event idempotency store (Data Model / TASK-053).
/// Unique external event ID prevents duplicate processing. Never store secrets or raw card data.
model PaymentEvent {
  id                     String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String                        @map("company_id") @db.Uuid
  methodCode             PaymentMethodCode             @map("method_code")
  /// Linked payment when matched; null when event arrives before a PENDING payment exists (TASK-058).
  paymentId              String?                       @map("payment_id") @db.Uuid
  /// Provider external event id (e.g. Stripe evt_…). Unique per method for idempotency.
  externalEventId        String                        @map("external_event_id")
  externalTransactionId  String?                       @map("external_transaction_id")
  /// Normalized application payment status derived from the provider event.
  normalizedStatus       PaymentStatus?                @map("normalized_status")
  /// Optional fee from provider — reconciliation metadata only (BR-020); not applied to balance.
  processorFeeAmount     Decimal?                      @map("processor_fee_amount") @db.Decimal(19, 4)
  processingStatus       PaymentEventProcessingStatus  @default(RECEIVED) @map("processing_status")
  correlationId          String                        @map("correlation_id")
  /// Safe diagnostic message only — never secrets, signatures, or credential material.
  errorMessage           String?                       @map("error_message")
  processedAt            DateTime?                     @map("processed_at") @db.Timestamptz
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                      @updatedAt @map("updated_at") @db.Timestamptz
  company                Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payment                Payment?                      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([methodCode, externalEventId])
  @@index([companyId, methodCode])
  @@index([paymentId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("payment_events")
}

/// Adjustment kind on a linked original payment (Data Model / Refunds Disputes Chargebacks).
enum PaymentAdjustmentType {
  DISPUTE
  REFUND
  CHARGEBACK
  REVERSAL
  NOTE

  @@map("payment_adjustment_type")
}

/// Adjustment lifecycle. Dispute OPEN / UNDER_REVIEW has no financial deduction (BR-024).
enum PaymentAdjustmentStatus {
  OPEN
  UNDER_REVIEW
  PROCESSED
  DEBITED
  LOST
  WON
  REVERSED
  CANCELLED

  @@map("payment_adjustment_status")
}

/// Linked refund/dispute/chargeback/note record (BR-023). Original SUCCESSFUL payment is never overwritten.
/// TASK-063 writes DISPUTE + OPEN/UNDER_REVIEW. TASK-064/065 write REFUND + PROCESSED.
/// TASK-066 writes CHARGEBACK + DEBITED/LOST (included in CB/RF; BR-024).
/// TASK-067 writes REVERSAL + WON/REVERSED (subtracts from CB/RF; does not edit debit row).
/// TASK-068 writes NOTE + OPEN (informational); cancel sets CANCELLED (retained; excluded from totals).
model PaymentAdjustment {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String                    @map("company_id") @db.Uuid
  paymentId         String                    @map("payment_id") @db.Uuid
  type              PaymentAdjustmentType
  status            PaymentAdjustmentStatus
  /// Stored disputed/refund/chargeback amount (Decimal). Open disputes do not deduct outstanding or CB/RF.
  amount            Decimal                   @db.Decimal(19, 4)
  invoiceAmount     Decimal?                  @map("invoice_amount") @db.Decimal(19, 4)
  settlementAmount  Decimal?                  @map("settlement_amount") @db.Decimal(19, 4)
  reason            String?
  merchantReference String?                   @map("merchant_reference")
  notes             String?
  effectiveDate     DateTime                  @map("effective_date") @db.Date
  openedAt          DateTime?                 @map("opened_at") @db.Timestamptz
  processedAt       DateTime?                 @map("processed_at") @db.Timestamptz
  resolvedAt        DateTime?                 @map("resolved_at") @db.Timestamptz
  createdByUserId   String?                   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payment           Payment                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy         User?                     @relation("PaymentAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, type, status])
  @@index([companyId, type])
  @@index([effectiveDate])
  @@map("payment_adjustments")
}

/// Generated report export file metadata (TASK-090 / ADR-005 / ADR-006).
/// Binary lives in StorageService; filters and totals preserved for audit.
enum ReportExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("report_export_status")
}

enum ReportExportFormat {
  CSV
  XLSX

  @@map("report_export_format")
}

model ReportExport {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportType        String             @map("report_type")
  format            ReportExportFormat
  status            ReportExportStatus @default(PENDING)
  storageKey        String?            @map("storage_key")
  checksumSha256    String?            @map("checksum_sha256") @db.Char(64)
  byteSize          Int?               @map("byte_size")
  contentType       String?            @map("content_type")
  filename          String
  filters           Json               @default("{}")
  rowCount          Int?               @map("row_count")
  totals            Json?              @map("totals")
  errorMessage      String?            @map("error_message")
  companyId         String?            @map("company_id") @db.Uuid
  requestedByUserId String             @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz
  requestedBy       User               @relation("ReportExportRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([requestedByUserId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("report_exports")
}
